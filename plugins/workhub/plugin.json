{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "workhub",
  "version": "0.9.0",
  "description": "Manage local Markdown task files across workspaces and projects, with a tree and kanban board.",
  "license": "MIT",
  "repository": "https://github.com/rzaytsev/workhub",
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "Workhub",
        "shortDescription": "Local tasks, tree and kanban",
        "longDescription": "Manage local Markdown task files across workspaces and projects, with a tree and kanban board.",
        "developerName": "Workhub contributors",
        "category": "Productivity",
        "capabilities": [
          "Interactive",
          "Read",
          "Write"
        ],
        "composerIcon": "./assets/icon.svg",
        "logo": "./assets/icon.svg",
        "defaultPrompt": [
          "Open my local todo workspace."
        ]
      }
    }
  }
}
