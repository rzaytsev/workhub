{
  "name": "workhub",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && vite build && tsup && node --import tsx scripts/package.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "dev": "node --import tsx src/dev.ts",
    "smoke": "node --import tsx scripts/smoke.ts",
    "test:browser": "node --import tsx scripts/browser-smoke.ts",
    "install-plugin": "node --import tsx scripts/install.ts",
    "check:publication": "python3 scripts/check-publication.py"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^1.0.0",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@openai/mcp-extensions": "^0.1.0",
    "dompurify": "^3.0.0",
    "marked": "^17.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "smol-toml": "^1.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.0.0",
    "@types/node": "^26.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.9",
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^6.0.0",
    "vite": "^8.0.0"
  },
  "overrides": {
    "esbuild": "^0.28.2"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/rzaytsev/workhub.git"
  },
  "bugs": {
    "url": "https://github.com/rzaytsev/workhub/issues"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
